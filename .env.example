# Supabase Configuration
# Get these values from your Supabase project settings at https://supabase.com
VITE_SUPABASE_PROJECT_ID="your_project_id"
VITE_SUPABASE_PUBLISHABLE_KEY="your_anon_key"
VITE_SUPABASE_URL="https://your-project.supabase.co"

# For local development, copy this file to .env and fill in your values:
# cp .env.example .env

# For production deployment on Vercel:
# 1. Go to your Vercel project settings
# 2. Add these environment variables in the "Environment Variables" section
# 3. Use the same keys and values from your Supabase project
